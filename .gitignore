# items/ and mapped/ are text and safe to commit. The originals usually
# are not (copyright, size), so they stay local. To commit them too,
# delete the raw/ lines.
inbox/*
!inbox/.gitkeep
raw/*
!raw/.gitkeep
!raw/manifest.yaml

# interrupted `shelf.py add`
items/.tmp-*

# OS / python noise
.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# lock file MinerU leaves in the folder it was started from
.mineru-service.lock
