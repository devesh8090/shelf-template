{
  "_about": "Known tools per job, best first, each with the minimum hardware tier it needs (low / mid / high, see `shelf.py setup`). Setup picks the first tool that fits the computer and installs it. pdf-text and scan-ocr list only tools that `shelf.py extract` can run. Agents change this file only with the user's approval.",
  "updated": "2026-10-22",
  "categories": {
    "pdf-text": {
      "job": "born-digital PDFs: text plus math, tables and figures",
      "fallback": null,
      "tools": [
        {
          "name": "mineru",
          "min_tier": "mid",
          "detect": [
            "mineru"
          ],
          "why": "MinerU 4: layout, math (LaTeX) and tables; `shelf.py extract` runs it page by page",
          "url": "https://github.com/opendatalab/MinerU",
          "install": {
            "pip": "mineru"
          }
        },
        {
          "name": "pypdf",
          "min_tier": "low",
          "builtin": true,
          "detect": [],
          "why": "built into shelf.py: plain text, no math or tables",
          "url": "https://pypdf.readthedocs.io",
          "install": {}
        }
      ]
    },
    "scan-ocr": {
      "job": "printed scans and photocopies: OCR to text",
      "fallback": "the agent reads the page images (costs tokens)",
      "tools": [
        {
          "name": "mineru",
          "min_tier": "mid",
          "detect": [
            "mineru"
          ],
          "why": "MinerU 4: OCR plus layout, math and tables, page by page",
          "url": "https://github.com/opendatalab/MinerU",
          "install": {
            "pip": "mineru"
          }
        },
        {
          "name": "ocrmypdf",
          "min_tier": "low",
          "detect": [
            "ocrmypdf"
          ],
          "why": "adds a text layer to scanned PDFs (uses tesseract)",
          "url": "https://github.com/ocrmypdf/OCRmyPDF",
          "install": {
            "apt": "ocrmypdf",
            "dnf": "ocrmypdf",
            "pacman": "ocrmypdf",
            "brew": "ocrmypdf",
            "pip": "ocrmypdf"
          }
        },
        {
          "name": "tesseract",
          "min_tier": "low",
          "detect": [
            "tesseract"
          ],
          "why": "basic OCR engine; fine for clean printed text",
          "url": "https://github.com/tesseract-ocr/tesseract",
          "install": {
            "apt": "tesseract-ocr",
            "dnf": "tesseract",
            "pacman": "tesseract",
            "brew": "tesseract",
            "winget": "UB-Mannheim.TesseractOCR"
          }
        }
      ]
    },
    "render": {
      "job": "PDF pages to images, so the agent can read scanned pages (`shelf.py render`)",
      "fallback": null,
      "tools": [
        {
          "name": "pdftoppm",
          "min_tier": "low",
          "detect": [
            "pdftoppm"
          ],
          "why": "fast, standard (poppler)",
          "url": "https://poppler.freedesktop.org",
          "install": {
            "apt": "poppler-utils",
            "dnf": "poppler-utils",
            "pacman": "poppler",
            "brew": "poppler",
            "conda": "poppler"
          }
        },
        {
          "name": "mutool",
          "min_tier": "low",
          "detect": [
            "mutool"
          ],
          "why": "MuPDF's renderer; good backup",
          "url": "https://mupdf.com",
          "install": {
            "apt": "mupdf-tools",
            "dnf": "mupdf",
            "pacman": "mupdf-tools",
            "brew": "mupdf-tools"
          }
        }
      ]
    },
    "office": {
      "job": ".docx / .pptx / .odt to PDF",
      "fallback": "ask the user to export a PDF",
      "tools": [
        {
          "name": "libreoffice",
          "min_tier": "low",
          "detect": [
            "soffice",
            "libreoffice"
          ],
          "why": "converts every office format headlessly",
          "url": "https://www.libreoffice.org",
          "install": {
            "apt": "libreoffice",
            "dnf": "libreoffice",
            "pacman": "libreoffice-fresh",
            "brew": "--cask libreoffice",
            "winget": "TheDocumentFoundation.LibreOffice"
          }
        }
      ]
    },
    "images": {
      "job": "readable JPG copies of iPhone HEIC photos (used by `shelf.py add-scan`)",
      "fallback": "ask the user to export JPG/PNG",
      "tools": [
        {
          "name": "imagemagick",
          "min_tier": "low",
          "detect": [
            "magick",
            "identify"
          ],
          "why": "converts and fixes images, including HEIC on most builds",
          "url": "https://imagemagick.org",
          "install": {
            "apt": "imagemagick",
            "dnf": "ImageMagick",
            "pacman": "imagemagick",
            "brew": "imagemagick",
            "winget": "ImageMagick.ImageMagick"
          }
        },
        {
          "name": "heif-convert",
          "min_tier": "low",
          "detect": [
            "heif-convert",
            "heif-dec"
          ],
          "why": "iPhone HEIC photos to JPG",
          "url": "https://github.com/strukturag/libheif",
          "install": {
            "apt": "libheif-examples",
            "dnf": "libheif-tools",
            "pacman": "libheif",
            "brew": "libheif"
          }
        }
      ]
    }
  }
}
